# ============================================================
# CONFIGURACIÓN DEL BOT DE TRADING - BINANCE TESTNET
# Copia este archivo a .env y completa los valores reales
# NUNCA commitees el archivo .env real al repositorio
# ============================================================

# ------------------------------------------------------------------
# BINANCE TESTNET API KEYS (OBLIGATORIO)
# Obtén estas keys en: https://testnet.binance.vision/
# SOLO Testnet - NUNCA uses mainnet keys aquí
# ------------------------------------------------------------------
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_API_SECRET=your_testnet_api_secret_here

# URL base de Binance Testnet (NO CAMBIES ESTO)
BINANCE_BASE_URL=https://testnet.binance.vision

# ------------------------------------------------------------------
# BASE DE DATOS
# Para desarrollo local usa SQLite (simple, sin instalación extra)
# Para producción usa PostgreSQL (cambia DATABASE_URL abajo)
# ------------------------------------------------------------------
# SQLite (desarrollo local - default)
DATABASE_URL=sqlite+aiosqlite:///./trading_bot.db

# PostgreSQL (producción - descomenta y configura cuando migres)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/trading_bot

# ------------------------------------------------------------------
# TELEGRAM BOT (para notificaciones y kill switch remoto)
# Crea un bot con @BotFather en Telegram
# ------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ------------------------------------------------------------------
# CONFIGURACIÓN DE RIESGO (valores por defecto conservadores)
# Estos pueden sobrescribirse desde la config del bot
# ------------------------------------------------------------------
# Pérdida diaria máxima permitida (% del capital)
RISK_MAX_DAILY_LOSS_PCT=0.03

# Riesgo máximo por operación (% del capital)
RISK_MAX_POSITION_RISK_PCT=0.01

# Exposición total máxima (% del capital invertido simultáneamente)
RISK_MAX_TOTAL_EXPOSURE_PCT=0.20

# Drawdown máximo acumulado (% desde peak de capital) - apaga el bot
RISK_MAX_DRAWDOWN_PCT=0.15

# Umbral de volatilidad para circuit breaker (ATR % del precio)
RISK_VOLATILITY_THRESHOLD_PCT=0.05

# ------------------------------------------------------------------
# PARES Y TIMEFRAMES A OPERAR
# ------------------------------------------------------------------
TRADING_SYMBOLS=BTC/USDT,ETH/USDT
TRADING_TIMEFRAME=1h

# ------------------------------------------------------------------
# FASE 5 - FILTRO SENTIMIENTO / NOTICIAS (opcional, solo reduce/veta)
# ------------------------------------------------------------------
# Activa filtro de noticias como veto/reducción (nunca genera señal)
SENTIMENT_ENABLED=false
# Tokens (opcional, CryptoPanic funciona sin token en public=true)
CRYPTOPANIC_TOKEN=
NEWS_API_KEY=
# Umbrales (tone -1..1, relevancia 0..1)
SENTIMENT_VETO_THRESHOLD=-0.6
SENTIMENT_REDUCE_THRESHOLD=-0.3
SENTIMENT_RELEVANCE_VETO=0.8
SENTIMENT_RELEVANCE_REDUCE=0.6
SENTIMENT_REDUCE_FACTOR=0.5
# Eventos macro - pausa automática antes/después (ej. FOMC)
# Formato JSON: [{"name":"FOMC","time":"2026-09-17T18:00:00Z","before":2,"after":2}]
MACRO_EVENTS_JSON=

# ------------------------------------------------------------------
# CONFIGURACIÓN GENERAL
# ------------------------------------------------------------------
# Modo: "testnet" | "paper" | "live" (live SOLO con autorización explícita)
TRADING_MODE=testnet

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Zona horaria para reportes
TIMEZONE=UTC