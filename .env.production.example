# ============================================================
# FASE 6 - PRODUCCIÓN REAL (DINERO REAL) - REQUERIRE AUTORIZACIÓN EXPLÍCITA POR ESCRITO
# NUNCA COPIES .env A .env.production SIN REVISIÓN MANUAL PASO A PASO
# Monto mínimo que estés dispuesto a perder por completo
# ============================================================

# ------------------------------------------------------------------
# BINANCE MAINNET - SOLO SI AUTORIZASTE FASE 6 POR ESCRITO
# Verifica en Binance: API Management -> Restrictions -> Enable Withdrawals == OFF
# Y "Restrict access to trusted IPs only" con IP de tu VPS
# ------------------------------------------------------------------
BINANCE_API_KEY=your_MAINNET_api_key_here
BINANCE_API_SECRET=your_MAINNET_api_secret_here
BINANCE_BASE_URL=https://api.binance.com
# NO uses testnet URL aquí

# ------------------------------------------------------------------
# DOBLE CONFIRMACIÓN MANUAL - OBLIGATORIO, NO VIENE POR DEFECTO EN NINGÚN TEMPLATE
# Sin estas dos flags el bot SE NIEGA a arrancar en mainnet aunque las keys sean válidas
# Debes crearlas a mano, no se copian de .env.example
# ------------------------------------------------------------------
ALLOW_LIVE_TRADING=false
CONFIRM_LIVE_TRADING_I_UNDERSTAND_RISK=false
LIVE_TRADING_CONFIRM_PHRASE=

# ------------------------------------------------------------------
# BASE DE DATOS PRODUCCIÓN (separada de testnet)
# ------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://trader_prod:STRONG_PASSWORD@db:5432/trading_bot_prod

# ------------------------------------------------------------------
# RIESGO MÁS CONSERVADOR QUE TESTNET PARA ARRANQUE EN REAL
# Testnet usa 3%/1%/20% ; en real usa MITAD o menos
# ------------------------------------------------------------------
RISK_MAX_DAILY_LOSS_PCT=0.015
RISK_MAX_POSITION_RISK_PCT=0.005
RISK_MAX_TOTAL_EXPOSURE_PCT=0.10
RISK_MAX_DRAWDOWN_PCT=0.10
RISK_VOLATILITY_THRESHOLD_PCT=0.03

# ------------------------------------------------------------------
# TELEGRAM - alertas más frecuentes en real (poll cada 30s, notifica cada trade)
# ------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
LIVE_ALERT_EVERY_TRADE=true

# ------------------------------------------------------------------
# RESTRICCIÓN IP (opcional pero recomendado)
# ------------------------------------------------------------------
LIVE_ALLOWED_IPS=203.0.113.42

TRADING_MODE=live
TRADING_SYMBOLS=BTC/USDT
TRADING_TIMEFRAME=1h
LOG_LEVEL=INFO
